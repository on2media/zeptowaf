{
    "name": "on2media/zeptowaf",
    "description": "Zepto Web Application Framework",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "psr/container": "^1.1|^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "provide": {
        "psr/container-implementation": "1.0.0"
    },
    "autoload": {
        "psr-4": {
            "On2Media\\Zeptowaf\\": "src/"
        }
    },
    "scripts": {
        "phpcs-dry": "php-cs-fixer fix --verbose --allow-risky=yes --dry-run --diff",
        "phpcs-fix": "php-cs-fixer fix --verbose --allow-risky=yes"
    }
}
